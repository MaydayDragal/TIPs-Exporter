{
  "manifest_version": 3,
  "name": "TIPS Exporter",
  "version": "1.7.0",
  "minimum_chrome_version": "111",
  "description": "Download XENTRY TIPS Reader topics (with every prior version, attachments and links) and TIPS cases (readable report plus uploaded files), one at a time or in approved batches.",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["https://xentry.mercedes-benz.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "TIPS Exporter – open/close",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://xentry.mercedes-benz.com/tips-reader/*"],
      "js": ["pagesize-probe.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://xentry.mercedes-benz.com/tips-reader/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
