{
  "manifest_version": 3,
  "name": "TIPS Exporter",
  "version": "1.21.0",
  "minimum_chrome_version": "111",
  "description": "Keep local XENTRY TIPS LIs and attachments updated, preserve older files, and scrub user IDs and download dates from new PDFs.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "https://xentry.mercedes-benz.com/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Open or close TIPS Exporter"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TIPS Exporter \u2013 open/close",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://xentry.mercedes-benz.com/tips-reader/*"
      ],
      "js": [
        "pagesize-probe.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://xentry.mercedes-benz.com/tips-reader/*"
      ],
      "js": [
        "vendor/pdf-lib.min.js",
        "pdf-scrubber.js",
        "index-csv.js",
        "documents-client.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "folder-settings.html",
    "open_in_tab": true
  }
}
