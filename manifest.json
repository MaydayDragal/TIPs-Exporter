{
  "manifest_version": 3,
  "name": "TIPS Exporter",
  "version": "1.6.0",
  "description": "Download XENTRY TIPS Reader topics – specific LIs or batch-export (current PDF, attachments, links, revision history and prior versions) to zips, with per-batch approval and a resumable log.",
  "permissions": ["storage", "unlimitedStorage", "scripting"],
  "host_permissions": ["https://xentry.mercedes-benz.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "TIPS Exporter – open/close",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://xentry.mercedes-benz.com/tips-reader/*"],
      "js": ["pagesize-probe.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://xentry.mercedes-benz.com/tips-reader/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
